{
  "name": "smart-rasoi-server",
  "version": "1.0.0",
  "description": "Smart Rasoi - Express Backend & Prisma/SQLite Foundation",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "DATABASE_URL=\"file:./test.db\" node --test src/tests/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node src/scripts/seedRecipes.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1"
  }
}
