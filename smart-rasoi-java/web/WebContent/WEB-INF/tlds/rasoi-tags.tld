<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <description>Smart Rasoi Custom JSP Tag Library</description>
    <tlib-version>1.0</tlib-version>
    <short-name>rasoi</short-name>
    <uri>http://smartrasoi.com/tags</uri>

    <tag>
        <description>Formats a double numeric value as Indian Rupee currency (₹)</description>
        <name>currency</name>
        <tag-class>com.smartrasoi.web.CurrencyFormatTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <name>amount</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>double</type>
        </attribute>
    </tag>

</taglib>
